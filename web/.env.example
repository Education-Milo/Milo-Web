# URL de l'API Milo (sans slash final obligatoire)
VITE_API_BASE_URL=https://api.milo-education.fr

# Session : "true" (défaut) = refresh token dans un cookie httpOnly (?cookie=true),
# access token en mémoire uniquement. Mettre "false" en dev sur http://localhost
# si le back n'a pas REFRESH_COOKIE_SECURE=false (cookie Secure non posé en http).
VITE_AUTH_COOKIE_MODE=true

# Clé publique Web3Forms du formulaire de contact (vitrine)
VITE_WEB3FORMS_ACCESS_KEY=

# Endpoint Formspree du parcours bêta (/feedback/parcours-beta)
VITE_FORMSPREE_BETA_ENDPOINT=https://formspree.io/f/mgaoeeaa

# --- Référencement et mesure d'audience (voir SEO.md) ---
# Umami : statistiques sans cookie, événements, entonnoirs de conversion.
# Identifiant du site sur https://cloud.umami.is (déjà renseigné par défaut
# dans src/shared/lib/analytics.ts ; à définir seulement pour en changer)
VITE_UMAMI_WEBSITE_ID=
# Script Umami (à changer seulement pour une instance auto-hébergée)
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Vérification de propriété (contenu de la balise meta, pas la balise entière)
# Google Search Console : https://search.google.com/search-console
VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (alimente aussi ChatGPT Search, Copilot, DuckDuckGo)
VITE_BING_SITE_VERIFICATION=
