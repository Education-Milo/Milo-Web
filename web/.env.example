# URL de l'API Milo (sans slash final obligatoire)
VITE_API_BASE_URL=https://api.milo-education.fr

# Session : "true" (défaut) = refresh token dans un cookie httpOnly (?cookie=true),
# access token en mémoire uniquement. Mettre "false" en dev sur http://localhost
# si le back n'a pas REFRESH_COOKIE_SECURE=false (cookie Secure non posé en http).
VITE_AUTH_COOKIE_MODE=true

# Clé publique Web3Forms du formulaire de contact (vitrine)
VITE_WEB3FORMS_ACCESS_KEY=
